# ==============================================================================
# ResumeMatch AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env

# Application Settings
APP_NAME=ResumeMatch AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server & UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Storage Paths (relative to project root or absolute paths)
DATA_DIR=data
LOG_DIR=logs
MODEL_CACHE_DIR=models

# Document Parsing Configuration (Day 2 Milestone)
MAX_FILE_SIZE_MB=10

# NLP Feature Extraction (Day 4 Milestone)
DEFAULT_TOP_KEYWORDS=20
DEFAULT_TOP_KEYPHRASES=15

# Semantic Matching Engine Configuration (Day 5 Milestone)
MATCHING_METHOD=auto
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SEMANTIC_WEIGHT=0.6
SKILL_WEIGHT=0.4

# Candidate Ranking & Analytics (Roadmap: Day 6 - Day 7)
# DEFAULT_TOP_K=10
