# ==============================================================================
# ResumeMatch AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env

# Application Settings
APP_NAME=ResumeMatch AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server & UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Storage Paths (relative to project root or absolute paths)
DATA_DIR=data
LOG_DIR=logs
MODEL_CACHE_DIR=models

# NLP & Matching Configuration (Roadmap: Day 4 - Day 6)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# SIMILARITY_METRIC=cosine
# DEFAULT_TOP_K=10
